VECTOR_IMAGE=registry.example.com/observability/vector:0.58.0-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
AUTOMQ_BOOTSTRAP_SERVERS=automq.internal.example:9092
AUTOMQ_TOPIC=logs.prod.wangda-app.v1
AUTOMQ_USERNAME=logs-prod-wangda-app-producer
METRICS_BIND_IP=127.0.0.1
# 采集端内存上限（同时作为 memswap，上限不是预占）。按 file source 数量和重启后追赶量调整：
# 实测 2~6 个 source 约 400 MiB，40 个 source 稳态约 1.4 GiB；超过 20 个 source 建议 2g。
# 只用 docker update 改上限后必须同步本值并验证 compose config，否则下次重建会退回旧值。
VECTOR_MEM_LIMIT=1g

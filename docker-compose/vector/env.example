# Vector 配置
# 复制此文件为 .env 并修改相关参数

# VictoriaLogs 服务器配置（需要修改为实际的VictoriaLogs服务器地址）
VICTORIALOGS_HOST=victorialogs.example.internal
VICTORIALOGS_PORT=9428
VLS_ENDPOINT=http://${VICTORIALOGS_HOST}:${VICTORIALOGS_PORT}

# Vector 服务配置
VECTOR_PORT=8686
VECTOR_API_BIND=127.0.0.1
VECTOR_LOG_LEVEL=warn

# 时区设置
TIMEZONE=Asia/Shanghai

# 主机名标识（可自定义）
VECTOR_HOSTNAME=vector-server-01

# 日志路径配置（需要修改为实际的日志路径）
NGINX_LOG_PATH=/data/nginx/nginx_log
JAVA_LOG_PATH=/data/file_service/logs

# Vector 数据目录（宿主机路径）
VECTOR_DATA_DIR=/data/vector-docker/vector_data

# 资源上限（同时作为 memswap）。已有部署先测稳态内存再设置，建议 >= 稳态 1.5 倍；
# 只用 docker update 改上限后必须同步这里，否则下次重建会退回旧值。
VECTOR_CPUS=1.0
VECTOR_MEM_LIMIT=1g

# Docker 网络名称
DOCKER_NETWORK=vvg-monitoring

# 镜像配置。生产环境应先镜像到私有仓库，再修改 DOCKER_REGISTRY。
DOCKER_REGISTRY=docker.io
VECTOR_VERSION=0.58.0-alpine

# VictoriaLogs 配置
# 复制此文件为 .env 并修改相关参数

# 服务端口
VICTORIALOGS_PORT=9428

# 数据保留期（天）
VICTORIALOGS_RETENTION=180d

# 时区设置
TIMEZONE=Asia/Shanghai

# 数据存储目录（宿主机路径）
VICTORIALOGS_DATA_DIR=/data/victorialogs/victoria-logs-data

# 参考生产规格：4 核主机为查询容器保留 3 CPU 和 5 GiB。
# 小规格主机必须按实际资源下调，不要超配后依赖 OOM 回收。
VICTORIALOGS_CPUS=3.0
VICTORIALOGS_MEMORY_LIMIT=5g

# 查询控制。只有并发触顶/排队超时计数持续增长且 CPU、内存仍有余量时才提高并发。
VL_SEARCH_MAX_CONCURRENT_REQUESTS=4
VL_SEARCH_MAX_QUEUE_DURATION=1m
VL_DEFAULT_PARALLEL_READERS=1
VL_SEARCH_MAX_QUERY_DURATION=2m
VL_SEARCH_SLOW_QUERY_DURATION=8s

# Docker 网络名称
DOCKER_NETWORK=vvg-monitoring

# 镜像配置。生产环境应先镜像到私有仓库，再修改 DOCKER_REGISTRY。
DOCKER_REGISTRY=docker.io
VICTORIALOGS_VERSION=v1.52.0

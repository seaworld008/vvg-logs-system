# Grafana 配置。复制为 .env 后修改生产值。

# Grafana 主机可访问的 VictoriaLogs 查询地址。
VICTORIALOGS_URL=http://victorialogs.example.internal:9428

# Grafana 服务配置。
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_AUTO_ASSIGN_ORG_ROLE=Viewer
GRAFANA_LOG_LEVEL=info
GRAFANA_ALLOW_EMBEDDING=true
GRAFANA_CPU_LIMIT=2.0
GRAFANA_MEMORY_LIMIT=4g
GRAFANA_PIDS_LIMIT=512
TIMEZONE=Asia/Shanghai

# 持久化与网络。
GRAFANA_DATA_DIR=/data/grafana/grafana-data
GRAFANA_PLUGINS_DIR=/data/grafana/plugins/releases/grafana13.2.0-vl0.31.0-text6.3.0
DOCKER_NETWORK=vvg-monitoring

# Grafana 与插件分别固定版本；插件由准备脚本发布到只读版本目录。
GRAFANA_VERSION=13.2.0-ubuntu
VICTORIALOGS_PLUGIN_VERSION=0.31.0
BUSINESS_TEXT_PLUGIN_VERSION=6.3.0

# 运行时不联网安装插件，也不因插件升级重建 Grafana 镜像。
GRAFANA_IMAGE=grafana/grafana:13.2.0-ubuntu
